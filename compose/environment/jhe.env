# JHE Django settings for the local docker compose stack (`jhe` and `cron` services).
#
# Committed on purpose: every value here is public and local-only. It unlocks nothing
# outside your own machine. Never copy these into a real deployment, and never add them
# as fallbacks in jhe/settings.py.
#
# Precedence, later wins:
#   1. this file
#   2. compose/environment/local.secret.env   optional, gitignored: your real credentials
#   3. `environment:` in docker-compose.yml   SITE_URL and MCP_OAUTH_REDIRECT_URI, which
#                                             depend on the published host ports
#
# The test suite does not use this file; scripts/dev/test.sh uses ci/test_env.sh so local
# test runs match CI.

DEBUG=1
DJANGO_LOG_LEVEL=INFO

# The repo is bind-mounted at /code, so without this Django's load_dotenv() would also read
# a root .env meant for running JHE on the host (see jhe/settings.py).
JHE_IGNORE_DOTENV=1
SECRET_KEY=dev-insecure-secret-key-not-for-production

# Container-to-container calls (the MCP server hitting http://jhe:8000) need "jhe".
ALLOWED_HOSTS=localhost,127.0.0.1,jhe

# The compose `db` service. Must match compose/environment/db.env.
DB_NAME=jhe_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Invitation code for signing up new users from the home page.
REGISTRATION_INVITE_CODE=jhe

# OAuth app that `manage.py seed` creates for the MCP server. Must match
# JHE_CLIENT_ID / JHE_CLIENT_SECRET in compose/environment/mcp.env.
MCP_OAUTH_CLIENT_ID=jhe-mcp-local
MCP_OAUTH_CLIENT_SECRET=dev-insecure-mcp-client-secret

# OIDC_RSA_PRIVATE_KEY (signs id_tokens) is not here on purpose: compose/jhe-entrypoint.sh
# generates a dev-only key into local/oidc.key on first boot and exports it, so no private
# key is committed. Delete that file to rotate it.
